{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "derivation/derivation-record.v3", "title": "Derivation record with reconciled block-code vocabulary",
  "description": "A durable run record whose closing dispositions ledger is the sole authoritative non-publication surface (ADR-0020 decisions 1 and 1a). v3 reconciles the recorded block-code vocabulary with the runner emission (SOURCE_SET_UNCLOSED replaces the never-emitted SOURCE_SET_OPEN) and names the itemization tie-out invariant (ITEMIZATION_TIE_OUT_VIOLATION), both per ADR-0036 production conditions 1 and 3. Ledger totality and package membership are runner/package validation responsibilities.",
  "type": "object",
  "properties": {"schema": {"const": "derivation-record.v3"}, "record_id": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}, "phase": {"enum": ["started", "completed", "interrupted", "failed"]}, "workspace_revision": {"type": "integer", "minimum": 0}, "governance_pins": {"type": "array", "items": {"$ref": "#/$defs/pin"}}, "adoption_pin": {"$ref": "#/$defs/pin"}, "stop_reason": {"enum": ["saturated", "interrupted", "validation-failed", "execution-failed"]}, "dispositions": {"type": "array", "items": {"$ref": "#/$defs/disposition"}}},
  "required": ["schema", "record_id", "run_id", "phase", "workspace_revision", "governance_pins", "adoption_pin"], "additionalProperties": false,
  "allOf": [{"if": {"properties": {"phase": {"const": "started"}}, "required": ["phase"]}, "then": {"not": {"anyOf": [{"required": ["stop_reason"]}, {"required": ["dispositions"]}]}}, "else": {"required": ["stop_reason", "dispositions"]}}],
  "$defs": {
    "pin": {"type": "object", "properties": {"role": {"enum": ["adoption", "governance", "parameter", "input", "choice", "default", "composition", "citation", "package", "operation-semantics"]}, "id": {"type": "string", "minLength": 1}, "version": {"type": "string", "pattern": "^v[0-9]+$"}, "origin": {"enum": ["assertion", "declared_default"]}}, "required": ["role", "id", "version"], "additionalProperties": false, "allOf": [{"if": {"properties": {"role": {"const": "input"}}, "required": ["role"]}, "then": {"required": ["origin"]}, "else": {"not": {"required": ["origin"]}}}]},
    "disposition": {"type": "object", "properties": {"artifact_id": {"type": "string", "minLength": 1}, "disposition": {"enum": ["published", "blocked", "inapplicable"]}, "pins": {"type": "array", "items": {"$ref": "#/$defs/pin"}}, "finding_id": {"type": "string", "minLength": 1}, "act_id": {"type": "string", "minLength": 1}, "symbol": {"type": "string", "minLength": 1}, "code": {"enum": ["DEPENDENCY_ABSENT", "DEPENDENCY_INVALID", "CATEGORICAL_DOMAIN_MISMATCH", "SOURCE_SET_UNCLOSED", "VALUE_INVALID", "ITEMIZATION_TIE_OUT_VIOLATION"]}, "missing": {"type": "array", "items": {"type": "string", "minLength": 1}}, "guard_result": {"const": false}, "superseded_by": {"$ref": "#/$defs/pin"}}, "required": ["artifact_id", "disposition", "pins"], "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"disposition": {"const": "published"}}, "required": ["disposition"]}, "then": {"required": ["finding_id", "act_id", "symbol"], "not": {"anyOf": [{"required": ["code"]}, {"required": ["guard_result"]}, {"required": ["superseded_by"]}]}}},
        {"if": {"properties": {"disposition": {"const": "blocked"}}, "required": ["disposition"]}, "then": {"required": ["code", "missing"], "not": {"anyOf": [{"required": ["guard_result"]}, {"required": ["superseded_by"]}]}}},
        {"if": {"properties": {"disposition": {"const": "inapplicable"}}, "required": ["disposition"]}, "then": {"oneOf": [{"required": ["guard_result"], "not": {"required": ["superseded_by"]}}, {"required": ["superseded_by"], "not": {"required": ["guard_result"]}}]}}
      ]}
  }
}
