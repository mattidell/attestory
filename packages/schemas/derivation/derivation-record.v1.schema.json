{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "derivation/derivation-record.v1",
  "title": "Derivation record",
  "description": "A run account, its own citizen kind outside the act log (ADR-0008 decision 1). A run is bounded by a pair: an immutable record with phase 'started', then a separate immutable record with phase 'completed', 'interrupted', or 'failed'. Recovery after a crash appends a closing record; it never mutates the start record (decision 2). The closing record is structured data — no narrative (decision 3). Its dispositions distinguish evaluated-and-inapplicable rules from rules never reached (decision 4): an inapplicable disposition carries the guard_result and the pins the guard read, so 'why is this line empty?' is answered by walking the record, never by re-evaluating.",
  "type": "object",
  "properties": {
    "schema": { "const": "derivation-record.v1" },
    "record_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "phase": { "enum": ["started", "completed", "interrupted", "failed"] },
    "workspace_revision": { "type": "integer", "minimum": 0 },
    "governance_pins": { "type": "array", "items": { "$ref": "#/$defs/pin" } },
    "adoption_pin": { "$ref": "#/$defs/pin" },
    "stop_reason": { "enum": ["saturated", "interrupted", "validation-failed", "execution-failed"] },
    "published": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "symbol": { "type": "string", "minLength": 1 },
          "finding_id": { "type": "string", "minLength": 1 },
          "act_id": { "type": "string", "minLength": 1 }
        },
        "required": ["symbol", "finding_id", "act_id"],
        "additionalProperties": false
      }
    },
    "blocked": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "missing": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "required": ["artifact_id", "code", "missing"],
        "additionalProperties": false
      }
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "disposition": { "enum": ["published", "inapplicable", "blocked"] },
          "guard_result": { "type": "boolean" },
          "pins": { "type": "array", "items": { "$ref": "#/$defs/pin" } }
        },
        "required": ["artifact_id", "disposition", "pins"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema", "record_id", "run_id", "phase", "workspace_revision", "governance_pins", "adoption_pin"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "phase": { "const": "started" } } },
      "then": {
        "not": { "anyOf": [
          { "required": ["stop_reason"] },
          { "required": ["published"] },
          { "required": ["blocked"] },
          { "required": ["dispositions"] }
        ] }
      },
      "else": { "required": ["stop_reason", "published", "blocked", "dispositions"] }
    }
  ],
  "$defs": {
    "pin": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "parameter",
            "computation",
            "applicability",
            "field-mapping",
            "cross-form-bridge",
            "input",
            "choice",
            "adoption",
            "governance",
            "engine",
            "package",
            "operation-semantics"
          ]
        },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^v[0-9]+$" }
      },
      "required": ["role", "id", "version"],
      "additionalProperties": false
    }
  }
}
