{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "derivation/explanation-graph.v1",
  "title": "Shared explanation graph",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "roots",
    "nodes"
  ],
  "properties": {
    "schema": {
      "const": "explanation-graph.v1"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target",
          "role"
        ],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "authorization": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "id",
          "version",
          "kind",
          "symbol",
          "value",
          "produced_by",
          "edges"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "derived",
              "input",
              "reference"
            ]
          },
          "symbol": {
            "type": [
              "string",
              "null"
            ]
          },
          "value": {},
          "produced_by": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "id",
                  "version",
                  "role"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ]
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "target",
                "pin"
              ],
              "properties": {
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "pin": {
                  "type": "object",
                  "required": [
                    "id",
                    "version",
                    "role"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "role": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
