{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "derivation/artifact-package.v3",
  "title": "Closed package admitting rule-artifact.v3",
  "type": "object",
  "properties": {
    "schema": {"const": "artifact-package.v3"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^v[0-9]+$"},
    "scope": {"$ref": "#/$defs/scope"},
    "admitted_schemas": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["fact-type.v2", "bundle.v2", "rule-artifact.v2", "rule-artifact.v3", "operation-semantics.v2", "source-closure-mapping.v2", "source-family.v1", "taxable-interest-composition.v1", "citation.v1", "form-field.v2", "parameter-declaration.v1", "quantity-vocabulary.v1", "role-canon.v1"]}},
    "members": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/member"}},
    "input_bindings": {"type": "array", "uniqueItems": true, "items": {"type": "object", "properties": {"symbol": {"type": "string", "minLength": 1}, "fact_type": {"$ref": "#/$defs/exact_pin"}, "mode": {"enum": ["required", "optional_default"]}}, "required": ["symbol", "fact_type", "mode"], "additionalProperties": false}},
    "entrypoints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/member_ref"}},
    "composition_obligations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "package_checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "conflict_semantics": {"type": "array", "items": {"type": "object", "properties": {"symbol": {"type": "string", "minLength": 1}, "selected_producer": {"$ref": "#/$defs/member_ref"}}, "required": ["symbol", "selected_producer"], "additionalProperties": false}}
  },
  "required": ["schema", "id", "version", "scope", "admitted_schemas", "members", "input_bindings", "entrypoints", "composition_obligations", "package_checksum"],
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"members": {"contains": {"properties": {"schema": {"const": "rule-artifact.v2"}}, "required": ["schema"]}}}, "required": ["members"]}, "then": {"properties": {"admitted_schemas": {"contains": {"const": "rule-artifact.v2"}}}}},
    {"if": {"properties": {"members": {"contains": {"properties": {"schema": {"const": "rule-artifact.v3"}}, "required": ["schema"]}}}, "required": ["members"]}, "then": {"properties": {"admitted_schemas": {"contains": {"const": "rule-artifact.v3"}}}}}
  ],
  "$defs": {
    "scope": {"type": "object", "properties": {"tax_year": {"type": "integer"}, "jurisdiction": {"type": "string", "minLength": 1}, "family": {"type": "string", "minLength": 1}}, "required": ["tax_year", "jurisdiction", "family"], "additionalProperties": false},
    "exact_pin": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "pattern": "^v[0-9]+$"}}, "required": ["id", "version"], "additionalProperties": false},
    "member_ref": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "pattern": "^v[0-9]+$"}}, "required": ["id", "version"], "additionalProperties": false},
    "member": {"type": "object", "properties": {"role": {"enum": ["parameter", "computation", "applicability", "field-mapping", "cross-form-bridge", "form-field", "source-family", "source-closure-mapping", "composition", "fact-type", "fact-type-bundle", "citation", "operation-semantics"]}, "schema": {"enum": ["fact-type.v2", "bundle.v2", "rule-artifact.v2", "rule-artifact.v3", "operation-semantics.v2", "source-closure-mapping.v2", "source-family.v1", "taxable-interest-composition.v1", "citation.v1", "form-field.v2", "parameter-declaration.v1", "quantity-vocabulary.v1", "role-canon.v1"]}, "id": {"type": "string", "minLength": 1}, "version": {"type": "string", "pattern": "^v[0-9]+$"}}, "required": ["role", "schema", "id", "version"], "additionalProperties": false}
  }
}
