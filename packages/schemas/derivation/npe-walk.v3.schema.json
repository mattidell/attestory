{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "derivation/npe-walk.v3", "title": "Run-scoped non-publication explanation walk, completeness-value-violation vocabulary",
  "description": "Additive successor to npe-walk.v2 (ADR-0055 Decision 2). Widens the node block-code vocabulary with COMPLETENESS_VALUE_VIOLATION, mirroring derivation-record.v4. npe-walk.v1/v2 remain immutable history; every other block is unchanged from v2.",
  "type": "object", "properties": {"schema": {"const": "npe-walk.v3"}, "id": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}, "workspace_revision": {"type": "integer", "minimum": 0}, "root": {"$ref": "#/$defs/node"}}, "required": ["schema", "id", "run_id", "workspace_revision", "root"], "additionalProperties": false,
  "$defs": {
    "rule_reference": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "pattern": "^v[0-9]+$"}}, "required": ["id", "version"], "additionalProperties": false},
    "node": {"type": "object", "properties": {"node_id": {"type": "string", "minLength": 1}, "node_kind": {"enum": ["published", "blocked", "guard_inapplicable", "no_disposition_recorded"]}, "symbol": {"type": "string", "minLength": 1}, "rule_references": {"type": "array", "items": {"$ref": "#/$defs/rule_reference"}, "uniqueItems": true}, "finding_id": {"type": "string", "minLength": 1}, "code": {"enum": ["DEPENDENCY_ABSENT", "DEPENDENCY_INVALID", "CATEGORICAL_DOMAIN_MISMATCH", "SOURCE_SET_UNCLOSED", "VALUE_INVALID", "ITEMIZATION_TIE_OUT_VIOLATION", "COMPLETENESS_VALUE_VIOLATION"]}, "unmet_references": {"type": "array", "items": {"type": "string", "minLength": 1}}, "closing_phase": {"enum": ["started", "interrupted", "failed", "completed"]}, "children": {"type": "array", "items": {"$ref": "#/$defs/node"}}}, "required": ["node_id", "node_kind", "symbol", "rule_references"], "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"node_kind": {"const": "published"}}, "required": ["node_kind"]}, "then": {"required": ["finding_id"]}},
        {"if": {"properties": {"node_kind": {"const": "blocked"}}, "required": ["node_kind"]}, "then": {"required": ["code", "unmet_references"]}},
        {"if": {"properties": {"node_kind": {"const": "guard_inapplicable"}}, "required": ["node_kind"]}, "then": {"not": {"anyOf": [{"required": ["finding_id"]}, {"required": ["code"]}]}}},
        {"if": {"properties": {"node_kind": {"const": "no_disposition_recorded"}}, "required": ["node_kind"]}, "then": {"required": ["closing_phase"]}}
      ]}
  }
}
