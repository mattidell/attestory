{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "derivation/presentation-model.v3",
  "title": "Saved presentation with answer-target question groups",
  "type": "object",
  "required": [
    "schema",
    "runId",
    "pinLabels",
    "sections",
    "citationGroups",
    "attachments",
    "unsupportedSourceFindings",
    "explanationGraph",
    "sectionRoots",
    "dispositionNodes",
    "questionGroups"
  ],
  "properties": {
    "schema": {
      "const": "presentation-model.v3"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "pinLabels": {
      "type": "object"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resolved": {
            "type": "object",
            "properties": {
              "questionRefs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "groupId",
                    "reasonIndices",
                    "scopes"
                  ],
                  "properties": {
                    "groupId": {
                      "type": "string",
                      "pattern": "^question-[0-9a-f]{64}$"
                    },
                    "reasonIndices": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "scopes": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "required": [
                              "kind",
                              "id",
                              "version",
                              "status"
                            ],
                            "properties": {
                              "kind": {
                                "const": "family"
                              },
                              "id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "version": {
                                "type": "string",
                                "pattern": "^v[0-9]+$"
                              },
                              "horizonId": {
                                "type": "string",
                                "minLength": 1
                              },
                              "status": {
                                "enum": [
                                  "current",
                                  "stale",
                                  "unanswered"
                                ]
                              }
                            },
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "required": [
                              "kind",
                              "id",
                              "status"
                            ],
                            "properties": {
                              "kind": {
                                "const": "fact"
                              },
                              "id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "status": {
                                "enum": [
                                  "current",
                                  "stale",
                                  "unanswered"
                                ]
                              }
                            },
                            "additionalProperties": false
                          }
                        ]
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "citationGroups": {
      "type": "array"
    },
    "attachments": {
      "type": "array"
    },
    "unsupportedSourceFindings": {
      "type": "array"
    },
    "explanationGraph": {
      "type": "object",
      "required": [
        "schema",
        "run_id",
        "roots",
        "nodes"
      ],
      "properties": {
        "schema": {
          "const": "explanation-graph.v1"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "roots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "target",
              "role"
            ],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "authorization": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        },
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "id",
              "version",
              "kind",
              "symbol",
              "value",
              "produced_by",
              "edges"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "derived",
                  "input",
                  "reference"
                ]
              },
              "symbol": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "value": {},
              "produced_by": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "id",
                      "version",
                      "role"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1
                      },
                      "role": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": true
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "target",
                    "pin"
                  ],
                  "properties": {
                    "target": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pin": {
                      "type": "object",
                      "required": [
                        "id",
                        "version",
                        "role"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "version": {
                          "type": "string",
                          "minLength": 1
                        },
                        "role": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "sectionRoots": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind",
              "root"
            ],
            "properties": {
              "kind": {
                "const": "published"
              },
              "root": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "kind",
              "root"
            ],
            "properties": {
              "kind": {
                "const": "disposition"
              },
              "root": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "dispositionNodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "symbol",
          "records",
          "children"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "records": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "children": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "findingRoot": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "authorization": {},
    "provenanceGroups": {},
    "calculationView": {},
    "line21Explanation": {},
    "mortgageInterestExplanation": {},
    "mortgageBorrowingExplanation": {},
    "f1099kStatementExplanation": {},
    "questionGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "answerTarget",
          "producers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^question-[0-9a-f]{64}$"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "answerTarget": {
            "type": "object",
            "required": [
              "factTypeId",
              "factTypeVersion",
              "factId",
              "identityKeys"
            ],
            "properties": {
              "factTypeId": {
                "type": "string",
                "minLength": 1
              },
              "factTypeVersion": {
                "type": "string",
                "pattern": "^v[0-9]+$"
              },
              "factId": {
                "type": "string",
                "minLength": 1
              },
              "identityKeys": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "value"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "statementLabel": {
                "type": "object",
                "minProperties": 1,
                "properties": {
                  "lender": {
                    "type": "string",
                    "minLength": 1
                  },
                  "statement": {
                    "type": "string",
                    "minLength": 1
                  },
                  "taxYear": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "anyOf": [
                  { "required": ["lender"] },
                  { "required": ["statement"] }
                ],
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "producers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "schema",
                "id",
                "version"
              ],
              "properties": {
                "schema": {
                  "enum": [
                    "input-question.v1",
                    "source-closure-mapping.v1",
                    "source-closure-mapping.v2",
                    "source-closure-mapping.v3",
                    "source-closure-mapping.v4"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "pattern": "^v[0-9]+$"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
