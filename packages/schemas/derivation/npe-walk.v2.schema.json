{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "derivation/npe-walk.v2", "title": "Run-scoped non-publication explanation walk, reconciled vocabulary",
  "description": "A pure, run-scoped projection of the durable disposition ledger and pin lineage. Rule references are arrays to preserve all package producers; no_disposition_recorded is explicit rather than inferred (ADR-0020 decisions 2-7). v2 reconciles the node block-code vocabulary with the runner emission (SOURCE_SET_UNCLOSED replaces the never-emitted SOURCE_SET_OPEN) and names the itemization tie-out invariant (ITEMIZATION_TIE_OUT_VIOLATION), both per ADR-0036 production conditions 1 and 3.",
  "type": "object", "properties": {"schema": {"const": "npe-walk.v2"}, "id": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}, "workspace_revision": {"type": "integer", "minimum": 0}, "root": {"$ref": "#/$defs/node"}}, "required": ["schema", "id", "run_id", "workspace_revision", "root"], "additionalProperties": false,
  "$defs": {
    "rule_reference": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "pattern": "^v[0-9]+$"}}, "required": ["id", "version"], "additionalProperties": false},
    "node": {"type": "object", "properties": {"node_id": {"type": "string", "minLength": 1}, "node_kind": {"enum": ["published", "blocked", "guard_inapplicable", "no_disposition_recorded"]}, "symbol": {"type": "string", "minLength": 1}, "rule_references": {"type": "array", "items": {"$ref": "#/$defs/rule_reference"}, "uniqueItems": true}, "finding_id": {"type": "string", "minLength": 1}, "code": {"enum": ["DEPENDENCY_ABSENT", "DEPENDENCY_INVALID", "CATEGORICAL_DOMAIN_MISMATCH", "SOURCE_SET_UNCLOSED", "VALUE_INVALID", "ITEMIZATION_TIE_OUT_VIOLATION"]}, "unmet_references": {"type": "array", "items": {"type": "string", "minLength": 1}}, "closing_phase": {"enum": ["started", "interrupted", "failed", "completed"]}, "children": {"type": "array", "items": {"$ref": "#/$defs/node"}}}, "required": ["node_id", "node_kind", "symbol", "rule_references"], "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"node_kind": {"const": "published"}}, "required": ["node_kind"]}, "then": {"required": ["finding_id"]}},
        {"if": {"properties": {"node_kind": {"const": "blocked"}}, "required": ["node_kind"]}, "then": {"required": ["code", "unmet_references"]}},
        {"if": {"properties": {"node_kind": {"const": "guard_inapplicable"}}, "required": ["node_kind"]}, "then": {"not": {"anyOf": [{"required": ["finding_id"]}, {"required": ["code"]}]}}},
        {"if": {"properties": {"node_kind": {"const": "no_disposition_recorded"}}, "required": ["node_kind"]}, "then": {"required": ["closing_phase"]}}
      ]}
  }
}
