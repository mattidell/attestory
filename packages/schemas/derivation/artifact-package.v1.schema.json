{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "derivation/artifact-package.v1",
  "title": "Artifact package",
  "description": "A closed manifest (ADR-0006 decision 6): exact member versions, scope as content, and — enforced by the package validator, not this schema alone — closure in both directions and unique output ownership (decision 7). Members are pins drawn from the one role vocabulary shared with rule-artifact role and publication/record pins (decision 9). Two members may publish the same symbol only if conflict_semantics is declared as content.",
  "type": "object",
  "properties": {
    "schema": { "const": "artifact-package.v1" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^v[0-9]+$" },
    "scope": {
      "type": "object",
      "properties": {
        "tax_year": { "type": "integer" },
        "jurisdiction": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "effective_from": { "type": "string", "format": "date" }
      },
      "required": ["tax_year", "jurisdiction", "family"],
      "additionalProperties": false
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pin" }
    },
    "conflict_semantics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "symbol": { "type": "string", "minLength": 1 },
          "resolution": { "type": "string", "minLength": 1 }
        },
        "required": ["symbol", "resolution"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema", "id", "version", "scope", "members"],
  "additionalProperties": false,
  "$defs": {
    "pin": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "parameter",
            "computation",
            "applicability",
            "field-mapping",
            "cross-form-bridge",
            "input",
            "choice",
            "adoption",
            "governance",
            "engine",
            "package",
            "operation-semantics"
          ]
        },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^v[0-9]+$" }
      },
      "required": ["role", "id", "version"],
      "additionalProperties": false
    }
  }
}
