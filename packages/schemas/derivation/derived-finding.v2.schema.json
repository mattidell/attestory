{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "derivation/derived-finding.v2", "title": "Derived finding with resolved input branch",
  "description": "A fully pinned derived determination. Input pins record assertion or declared-default origin transitively; a default-resolution finding uses the closed resolved_input branch (ADR-0025 decisions 2-3).",
  "type": "object",
  "properties": {"schema": {"const": "derived-finding.v2"}, "id": {"type": "string", "minLength": 1}, "symbol": {"type": "string", "minLength": 1}, "value": {}, "version": {"const": "v2"}, "pins": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pin"}}, "resolved_input": {"type": "object", "properties": {"fact_id": {"type": "string", "minLength": 1}, "origin": {"const": "declared_default"}}, "required": ["fact_id", "origin"], "additionalProperties": false}},
  "required": ["schema", "id", "symbol", "value", "version", "pins"], "additionalProperties": false,
  "$defs": {
    "pin": {
      "type": "object",
      "properties": {"role": {"enum": ["parameter", "computation", "applicability", "field-mapping", "cross-form-bridge", "input", "choice", "default", "composition", "citation", "adoption", "governance", "engine", "package", "operation-semantics"]}, "id": {"type": "string", "minLength": 1}, "version": {"type": "string", "pattern": "^v[0-9]+$"}, "origin": {"enum": ["assertion", "declared_default"]}},
      "required": ["role", "id", "version"],
      "additionalProperties": false,
      "allOf": [{"if": {"properties": {"role": {"const": "input"}}, "required": ["role"]}, "then": {"required": ["origin"]}, "else": {"not": {"required": ["origin"]}}}]
    }
  }
}
