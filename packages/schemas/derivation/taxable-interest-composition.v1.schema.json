{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "derivation/taxable-interest-composition.v1", "title": "Taxable-interest composition",
  "description": "A closed, coextensive declaration over positive taxable-interest source-family slots. Package validation performs exact slot/rule bijection and adopted-member resolution (ADR-0026).",
  "type": "object", "properties": {"schema": {"const": "taxable-interest-composition.v1"}, "id": {"type": "string", "minLength": 1}, "version": {"type": "string", "pattern": "^v[0-9]+$"}, "constituents": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "properties": {"source_family": {"$ref": "#/$defs/pin"}, "authorizes_subtotal": {"type": "string", "minLength": 1}}, "required": ["source_family", "authorizes_subtotal"], "additionalProperties": false}}, "required_universe": {"type": "object", "properties": {"claim": {"type": "string", "minLength": 1}}, "required": ["claim"], "additionalProperties": false}, "publishes": {"type": "string", "minLength": 1}, "coextensiveness": {"const": "slot-bijection"}}, "required": ["schema", "id", "version", "constituents", "required_universe", "publishes", "coextensiveness"], "additionalProperties": false, "$defs": {"pin": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "pattern": "^v[0-9]+$"}}, "required": ["id", "version"], "additionalProperties": false}}}
