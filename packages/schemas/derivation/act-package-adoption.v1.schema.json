{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "derivation/act-package-adoption.v1",
  "title": "Package adoption act payload",
  "description": "ADR-0033 D1: A declared Article-4 user act authorizing production resolution.",
  "type": "object",
  "properties": {
    "package": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "checksum": { "type": "string", "minLength": 64, "maxLength": 64 }
      },
      "required": ["id", "version", "checksum"],
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "checksum": { "type": "string", "minLength": 64, "maxLength": 64 }
      },
      "required": ["id", "version", "checksum"],
      "additionalProperties": false
    },
    "user_actor": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 },
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "revision": { "type": "integer", "minimum": 0 },
    "supersedes": { "type": "string", "minLength": 1 },
    "audit_metadata": { "type": "object" }
  },
  "required": ["package", "release", "user_actor", "scope", "revision"],
  "additionalProperties": false
}
