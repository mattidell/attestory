{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "tax/form-field.v3", "title": "Form field with exact citation attachment, reconciled vocabulary",
  "description": "Presentation-only official field with at most one exact structured citation pin. v3 reconciles the blocked-code vocabulary with the runner emission (SOURCE_SET_UNCLOSED replaces the never-emitted SOURCE_SET_OPEN) per ADR-0036 production condition 3; rendering remains a future consumer concern (ADR-0012 amendment; ADR-0029).",
  "type": "object", "properties": {"schema": {"const": "form-field.v3"}, "id": {"type": "string", "minLength": 1}, "version": {"type": "string", "pattern": "^v[0-9]+$"}, "form": {"type": "object", "properties": {"authority": {"type": "string", "minLength": 1}, "form_id": {"type": "string", "minLength": 1}, "tax_year": {"type": "integer"}, "jurisdiction": {"type": "string", "minLength": 1}}, "required": ["authority", "form_id", "tax_year", "jurisdiction"], "additionalProperties": false}, "line": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "binds_symbol": {"type": "string", "minLength": 1}, "citation": {"$ref": "#/$defs/pin"}, "dispositions": {"type": "object", "properties": {"published_value": {"$ref": "#/$defs/instruction"}, "computed_zero": {"$ref": "#/$defs/instruction"}, "closure_backed_zero": {"$ref": "#/$defs/instruction"}, "blocked": {"$ref": "#/$defs/blocked_instruction"}, "guard_inapplicable": {"$ref": "#/$defs/instruction"}}, "required": ["published_value", "computed_zero", "closure_backed_zero", "blocked", "guard_inapplicable"], "additionalProperties": false}}, "required": ["schema", "id", "version", "form", "line", "label", "description", "binds_symbol", "dispositions"], "additionalProperties": false,
  "$defs": {"pin": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "pattern": "^v[0-9]+$"}}, "required": ["id", "version"], "additionalProperties": false}, "instruction": {"type": "object", "properties": {"render": {"type": "string"}, "explain": {"type": "string", "minLength": 1}}, "required": ["render", "explain"], "additionalProperties": false}, "blocked_instruction": {"type": "object", "properties": {"render": {"type": "string"}, "explain": {"type": "string", "minLength": 1}, "codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["DEPENDENCY_ABSENT", "DEPENDENCY_INVALID", "CATEGORICAL_DOMAIN_MISMATCH", "SOURCE_SET_UNCLOSED"]}}}, "required": ["render", "explain", "codes"], "additionalProperties": false}}
}
