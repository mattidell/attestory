{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boundary/fixture-provenance-manifest.v1",
  "title": "Fixture Provenance Manifest",
  "description": "ADR-0031 D1 rule 6: Manifest accompanying every fixture/golden proving synthetic derivation.",
  "type": "object",
  "properties": {
    "schema": { "const": "fixture-provenance-manifest.v1" },
    "generator": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "minLength": 1 }
      },
      "required": ["id", "version", "digest"],
      "additionalProperties": false
    },
    "grammar_digest": { "type": "string", "minLength": 1 },
    "profile_digest": { "type": "string", "minLength": 1 },
    "seed": { "type": "string", "minLength": 1 },
    "constraints": { "type": "object" },
    "input_kinds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "attestation_no_live_data": { "const": true }
  },
  "required": [
    "schema",
    "generator",
    "grammar_digest",
    "profile_digest",
    "seed",
    "constraints",
    "input_kinds",
    "attestation_no_live_data"
  ],
  "additionalProperties": false
}
