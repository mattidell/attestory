{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kernel/bundle.v2",
  "title": "Versioned fact-type bundle",
  "description": "Wholesale bundle with exact versioned nested fact identities (ADR-0028 decisions 1-3). Nested fact-type bodies are validated against their declared schema by the kernel; this schema fixes their v2 generation and exact identity fields.",
  "type": "object",
  "properties": {"schema": {"const": "bundle.v2"}, "id": {"type": "string", "minLength": 1}, "version": {"type": "string", "pattern": "^v[0-9]+$"}, "label": {"type": "string", "minLength": 1}, "fact_types": {"type": "array", "minItems": 1, "items": {"type": "object", "properties": {"schema": {"const": "fact-type.v2"}, "id": {"type": "string", "minLength": 1}, "version": {"type": "string", "pattern": "^v[0-9]+$"}}, "required": ["schema", "id", "version"], "additionalProperties": true}}},
  "required": ["schema", "id", "version", "label", "fact_types"], "additionalProperties": false
}
