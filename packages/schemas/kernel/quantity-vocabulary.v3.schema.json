{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kernel/quantity-vocabulary.v3",
  "title": "Tax quantity vocabulary, capital-gain distributions added",
  "description": "Immutable, versioned closed vocabulary for quantity identities used by residual-closed source amount fact types (ADR-0028 decision 7). v3 adds capital-gain-distributions for the successor Form 1099-DIV box-2a member (ADR-0050 decision 2). v1 and v2 remain immutable history.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "quantity-vocabulary.v3"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "quantities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "taxable-interest",
          "wages",
          "standard-deduction",
          "taxable-income",
          "income-tax",
          "ordinary-dividends",
          "qualified-dividends",
          "capital-gain-distributions"
        ]
      }
    }
  },
  "required": [
    "schema",
    "id",
    "version",
    "quantities"
  ],
  "additionalProperties": false
}
