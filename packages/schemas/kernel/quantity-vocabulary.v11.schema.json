{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kernel/quantity-vocabulary.v11",
  "title": "Tax quantity vocabulary, IRA distributions added",
  "description": "Immutable, versioned closed vocabulary for quantity identities used by the bounded 2025 fully taxable IRA distribution route. v1-v10 remain immutable history.",
  "type": "object",
  "properties": {
    "schema": {"const": "quantity-vocabulary.v11"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^v[0-9]+$"},
    "quantities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": [
        "capital-gain-distributions",
        "covered-lt-basis",
        "covered-lt-proceeds",
        "covered-ltcg-basis",
        "covered-ltcg-proceeds",
        "covered-st-basis",
        "covered-st-proceeds",
        "exempt-interest-dividends",
        "foreign-tax-paid",
        "income-tax",
        "ira-distributions",
        "ordinary-dividends",
        "qualified-dividends",
        "standard-deduction",
        "taxable-income",
        "taxable-interest",
        "tax-exempt-interest",
        "unemployment-compensation",
        "wages"
      ]}
    }
  },
  "required": ["schema", "id", "version", "quantities"],
  "additionalProperties": false
}
