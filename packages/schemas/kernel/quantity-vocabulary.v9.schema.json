{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kernel/quantity-vocabulary.v9",
  "title": "Tax quantity vocabulary, unemployment compensation added",
  "description": "Immutable, versioned closed vocabulary for quantity identities used by residual-closed source amount fact types (ADR-0028 decision 7). v9 adds unemployment-compensation for the Form 1099-G box-1 member on the bounded Schedule 1 line 7 / Form 1040 line 8 route (renumbered off contested v7/v8). v1–v8 remain immutable history when present.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "quantity-vocabulary.v9"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "quantities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "taxable-interest",
          "wages",
          "standard-deduction",
          "taxable-income",
          "income-tax",
          "ordinary-dividends",
          "qualified-dividends",
          "capital-gain-distributions",
          "covered-ltcg-proceeds",
          "covered-ltcg-basis",
          "covered-lt-proceeds",
          "covered-lt-basis",
          "covered-st-proceeds",
          "covered-st-basis",
          "exempt-interest-dividends",
          "unemployment-compensation"
        ]
      }
    }
  },
  "required": [
    "schema",
    "id",
    "version",
    "quantities"
  ],
  "additionalProperties": false
}
