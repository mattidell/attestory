{
  "schema": "bundle.v2",
  "id": "tax.us.2025.f1099b.covered-admission.vocabulary",
  "version": "v1",
  "label": "Whether each covered or code W Form 1099-B sale is admitted to this return",
  "fact_types": [
    {
      "schema": "fact-type.v2",
      "id": "tax.us.2025.f1099b.covered-st-txn.admission",
      "version": "v1",
      "title": "Whether one short-term Form 1099-B sale reported on line 1a is admitted to this return.",
      "nature": "determinable",
      "identity_keys": [
        {
          "name": "broker",
          "kind": "entity",
          "entity_kind": "tax.us.f1099b-broker"
        },
        {
          "name": "statement",
          "kind": "entity",
          "entity_kind": "tax.us.f1099b-statement"
        },
        {
          "name": "transaction",
          "kind": "entity",
          "entity_kind": "tax.us.f1099b-transaction"
        },
        {
          "name": "tax-year",
          "kind": "literal",
          "values": [
            "2025"
          ]
        }
      ],
      "value_schema": {
        "oneOf": [
          {
            "const": "admitted",
            "description": "The sale has no adjustment you make yourself and is recorded only once."
          },
          {
            "const": "taxpayer-side-adjustment",
            "description": "The sale is flagged with an adjustment you make yourself, which this return does not compute."
          },
          {
            "const": "recorded-twice",
            "description": "The same transaction is also recorded as a sale of the other term."
          },
          {
            "const": "flagged-outside-class",
            "description": "The sale is flagged as ordinary income, market discount, a qualified opportunity fund investment, or a collectibles or other special-rate gain, which this return does not compute."
          }
        ]
      },
      "supersession": {
        "policy": "free"
      }
    },
    {
