{
  "schema": "attachment-rule.v12",
  "id": "tax.us.2025.rule.attachment.schedule-a",
  "version": "v4",
  "title": "Schedule A itemized deductions attachment. Requires the derived Schedule A excess-over-standard result and the seven explicit non-mortgage category boundaries. Core v70 (attachment-limited-part): a conditional two-part itemization. The line 8a part applies only when the Form 1098 family is closed with a statement, so a losses-only itemizer is no longer blocked on line 8a. The line 16 part applies only when line 16 is nonzero; it shows the recorded gambling losses as reported and ties line 16 to the lesser of those losses and the gambling winnings (Form W-2G box 1 subtotal), with the amount not counted recorded. Losses with no Form W-2G leave line 16 at 0 and the part out.",
  "scope": {
    "tax_year": 2025,
    "jurisdiction": "US-federal",
    "family": "individual-income-tax"
  },
  "attachment": {
    "authority": "IRS",
    "form_id": "1040-SCH-A",
    "tax_year": 2025,
    "jurisdiction": "US-federal"
  },
