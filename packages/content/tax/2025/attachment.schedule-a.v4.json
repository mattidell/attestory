    ],
    "threshold_parameter": {
      "id": "tax.us.2025.parameter.default-zero",
      "version": "v1"
    },
    "comparison": "strictly_greater_than",
    "citation": {
      "id": "tax.us.2025.citation.attachment.schedule-a",
      "version": "v1"
    }
  },
  "itemizations": [
