          },
          {
            "const": "seller-shipping-unanswered",
            "description": "The question regarding seller-paid shipping has no current answer."
          },
          {
            "const": "asset-type-unanswered",
            "description": "The question regarding digital assets has no current answer."
          },
          {
            "const": "personal-use-unconfirmed",
            "description": "The question regarding exclusive personal use has no current answer."
          },
          {
            "const": "purpose-unanswered",
            "description": "The question regarding primary purpose at acquisition has no current answer."
          },
          {
            "const": "acquisition-type-unanswered",
            "description": "The question regarding acquisition by purchase has no current answer."
          },
          {
            "const": "single-sale-unanswered",
            "description": "The question regarding single item sale scope has no current answer."
