        {
          "name": "tax-year",
          "kind": "literal",
          "values": [
            "2025"
          ]
        }
      ],
      "value_schema": {
        "oneOf": [
          {
            "const": "supported-loss",
            "description": "This sale resulted in a nondeductible personal loss whose Box 1a gross amount is entered at the top of Schedule 1."
          },
          {
            "const": "unsupported-gain",
            "description": "The sale resulted in a gain or profit, which cannot be reported as a personal item loss on Schedule 1."
          },
          {
            "const": "break-even-sale",
            "description": "The sale broke even with no gain or loss, so no adjustment is reported on Schedule 1."
          },
          {
            "const": "investment-purpose-excluded",
            "description": "The item was acquired for investment or profit; personal item loss treatment does not apply."
          },
          {
            "const": "resale-inventory-excluded",
            "description": "The item was acquired for resale or business inventory; personal item loss treatment does not apply."
          },
          {
            "const": "prior-depreciable-use-excluded",
            "description": "The item was used for business or rental purposes; personal item loss treatment does not apply."
          },
          {
            "const": "digital-asset-excluded",
            "description": "The transaction involved digital assets or virtual currency, which are outside the scope of this personal item sale route."
          },
          {
            "const": "multi-sale-statement-unsupported",
            "description": "The Form 1099-K statement covers more than a single personal item sale."
          },
          {
            "const": "non-purchase-acquisition-unsupported",
            "description": "The item was not acquired by purchase."
          },
          {
            "const": "basis-adjustment-unsupported",
            "description": "Lasting improvements or other basis adjustments were made to the item."
          },
          {
            "const": "backup-withholding-unsupported",
            "description": "Federal income tax was withheld (Box 4), which requires separate reporting."
          },
          {
            "const": "cost-basis-unknown",
            "description": "The original purchase cost of the item is unknown."
          },
          {
            "const": "shipping-arrangement-unknown",
            "description": "The shipping arrangement is unknown."
          },
          {
            "const": "buyer-payment-unknown",
            "description": "The agreed item price is unknown."
          },
          {
            "const": "platform-tax-unknown",
            "description": "The platform sales tax amount is unknown."
          },
          {
            "const": "buyer-shipping-unknown",
            "description": "The buyer-paid shipping amount is unknown."
          },
          {
            "const": "refund-status-unknown",
            "description": "The refund amount is unknown."
          },
          {
            "const": "platform-fees-unknown",
            "description": "The platform selling fees amount is unknown."
          },
          {
            "const": "seller-shipping-unknown",
            "description": "The seller-paid shipping amount is unknown."
          },
          {
            "const": "cannot-tell-improvements",
            "description": "It is not known whether lasting improvements or other basis adjustments were made to the item."
          },
          {
            "const": "cannot-tell-asset-type",
            "description": "It is not known whether the transaction involved digital assets or virtual currency."
          },
          {
            "const": "cannot-tell-use",
            "description": "It is not known whether the item was used exclusively for personal purposes."
          },
          {
            "const": "cannot-tell-purpose",
            "description": "It is not known whether the item was acquired for personal use."
          },
          {
            "const": "cannot-tell-acquisition",
            "description": "It is not known whether the item was acquired by purchase."
          },
          {
            "const": "cannot-tell-sale-scope",
            "description": "It is not known whether the statement covers only a single personal item sale."
          },
          {
            "const": "improvements-unanswered",
            "description": "The question regarding lasting improvements has no current answer."
          },
          {
            "const": "cost-basis-unanswered",
            "description": "The question regarding cost basis has no current answer."
          },
          {
            "const": "shipping-arrangement-unanswered",
            "description": "The question regarding shipping arrangement has no current answer."
          },
          {
            "const": "agreed-price-unanswered",
