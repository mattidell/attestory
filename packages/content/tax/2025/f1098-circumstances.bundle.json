    {
      "schema": "fact-type.v2",
      "id": "tax.us.2025.f1098.residence-interest-reason",
      "version": "v1",
      "title": "Classification of why this statement's interest is or is not qualified residence interest",
      "nature": "determinable",
      "identity_keys": [
        {
          "name": "payer",
          "kind": "entity",
          "entity_kind": "tax.us.mortgage-lender"
        },
        {
          "name": "statement",
          "kind": "entity",
          "entity_kind": "tax.us.1098-statement"
        },
        {
          "name": "tax-year",
          "kind": "literal",
          "values": [
            "2025"
          ]
        }
      ],
      "value_schema": {
        "oneOf": [
          {
            "const": "qualified",
            "description": "The recorded answers support treating this statement's interest as qualified residence interest for this bounded case."
          },
          {
            "const": "use-unrelated-personal-expense",
            "description": "The borrowed money paid for an unrelated personal expense, and neither timing exception applies; this route publishes no home-mortgage deduction."
          },
          {
            "const": "not-collateral",
            "description": "The home is not collateral for this loan, so this route publishes no home-mortgage deduction."
          },
          {
            "const": "not-paid",
            "description": "Neither you nor your joint-filing spouse paid any of this interest, and nobody paid any for you; this route publishes no deduction."
          },
          {
            "const": "owner-not-on-note",
            "description": "You paid the interest but do not owe the loan; this route does not determine whether an equitable owner may deduct it."
          },
          {
            "const": "timing-exception-possible",
            "description": "The loan may fall within a purchase or building timing exception; Publication 936 may treat it as acquisition debt, but this route does not compute the expense cap or decide substantial improvement."
          },
          {
            "const": "cannot-tell-timing",
            "description": "The borrowed money paid for a personal expense, but it is not yet known whether a purchase or building timing exception applies."
          },
          {
            "const": "timing-not-established",
            "description": "One or both timing questions have no current answer; answer them to determine whether an exception applies."
          },
          {
            "const": "possible-grandfathered-debt",
            "description": "This loan's origination date may qualify it as grandfathered debt; this route does not verify continuous security or refinancing history."
          },
          {
            "const": "cannot-tell-use",
            "description": "It is not yet known what the borrowed money paid for; the route cannot classify this interest until that answer is clear."
          },
          {
            "const": "cannot-tell-ownership",
            "description": "It is not yet known whether you own this home; the other recorded answers do not settle that question."
          },
          {
            "const": "cannot-tell-residence",
            "description": "It is not yet known whether this is the home where you live most of the time."
          },
          {
            "const": "cannot-tell-share",
            "description": "It is not yet known whether anyone else owes this loan with you; a joint-filing spouse is not treated as someone else."
          },
          {
            "const": "cannot-tell-collateral",
            "description": "It is not yet known whether the home is collateral for this loan."
          },
          {
            "const": "cannot-tell-payment",
            "description": "It is not yet known whether you or your joint-filing spouse paid the interest."
          },
          {
            "const": "payment-outside-coverage",
            "description": "Someone else paid some or all of this interest, or you paid only part; this route does not allocate or determine its treatment."
          },
          {
            "const": "certificate-received",
            "description": "You received a mortgage credit certificate; this route does not compute the related credit or deduction reduction."
          },
          {
            "const": "debt-limit-over",
            "description": "The reported principal exceeds this route's applicable debt limit, so it does not compute the deductible amount."
          },
          {
            "const": "outside-coverage",
            "description": "This account is outside the circumstances this route computes; its tax treatment remains unresolved here."
          }
        ]
      },
      "supersession": {
        "policy": "free"
      }
