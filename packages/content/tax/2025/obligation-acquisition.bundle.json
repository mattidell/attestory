            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "acquired_on": {
            "format": "date",
            "type": "string"
          },
          "concerns_reported_payer": {
            "minLength": 1,
            "type": "string"
          },
          "obligation_in_default_or_arrears_at_purchase": {
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "obligation_pays_periodically_in_arrears": {
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          }
        },
        "required": [
          "acquired_on",
          "concerns_reported_payer"
        ],
        "type": "object"
