  "basis": {
    "said": [
      "You own the home, or your spouse does if you file jointly, and it is your filing unit's shared main home. The home secures this original loan, and you or your spouse if filing jointly owes the loan and paid the interest.",
      "The borrowed money bought the home, no one else besides a joint-filing spouse owes the loan, and no mortgage credit certificate was received."
    ],
    "derived": [
      "The bounded single-statement route found one Form 1098 and uses the reported box 1 amount.",
      "The reported box 2 principal was compared directly with the filing-status limit; the limit check passed.",
      "The application concluded that this interest is qualified residence interest for this bounded case."
    ],
    "assumed": [
      "For this one original borrowing, box 2 stands for the acquisition-debt balance throughout the year; this route publishes all of box 1 without prorating."
    ],
    "left_with_person": [
      "A higher balance during the year, another mortgage or home, added draws, interest outside the year, points, mortgage-insurance premiums, and prior-year refunds are not computed here."
    ]
  },
  "notes": "Bounded calculation for a single ordinary Form 1098 mortgage statement; not complete Schedule A or filing support."
}
