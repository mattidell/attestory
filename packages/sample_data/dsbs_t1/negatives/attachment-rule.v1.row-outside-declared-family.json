{
  "schema": "attachment-rule.v1",
  "id": "demo.rule.attachment.schedule-x",
  "version": "v1",
  "title": "Negative: an itemization row injected outside the declared family's collect_members surface",
  "scope": { "tax_year": 2025, "jurisdiction": "US-federal", "family": "demo" },
