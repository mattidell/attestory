{
  "schema": "rule-artifact.v3",
  "id": "demo.rule.conditional-dependency-set",
  "version": "v1",
  "scope": {"tax_year": 2025, "jurisdiction": "US-federal", "family": "demo"},
  "role": "computation",
  "requires": ["demo.condition", "demo.result"],
  "pins": [],
  "when": {
    "op": "conditional_dependency_set",
    "condition": {"op": "ref", "name": "demo.condition"},
    "members": [
      {"op": "ref", "name": "demo.member.alpha"},
      {"op": "ref", "name": "demo.member.beta"}
