.DS_Store
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
temp/
local-data/
private-archive/
uploads/
generated/user/

# Owner-held live-run tooling (ADR-0031): untracked by absolute rule, never
# committed even accidentally by a future `git add -A`.
/tools/scaffold_live_acts.py
/workspace-seed/

# Headless-browser execution artifacts (owner-approved 2026-07-23). Playwright
# drops this at the repo root during UI-prototype evaluation; ignored, never
# committed. Synthetic-only, so no data-boundary concern.
.playwright-mcp/
# Ignore .claude contents (sessions, local overrides, secrets) but share
# intentional, auditable agent config: hooks (settings.json), role agent
# definitions (agents/), and slash commands (commands/). Add further exceptions
# here as shared config grows.
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/commands/

# Operational spawn/launch metrics (tools/spawn_ledger.py). Per-machine baseline;
# commit a snapshot deliberately if you want a shared one.
/metrics/

# Owner-supplied session artifacts — never repository content (ADR-0031)
owner_attestation.txt

# Vendored UI dependencies. The surface artifact ships its resolved dependency
# tree, but the repository does not store it — owner decision 2026-07-28.
# Regenerate before running the surface tests:
#   (cd packages/sample_data/surface_t1/content/app && npm ci)
#   python3 tools/generate_surface_t1_fixtures.py
node_modules/
