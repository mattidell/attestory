{
  "case": "v81/case/a_holding_mismatch",
  "positive_control": "expected_sentences",
  "basis": "No scratch pair is admissible (every successful pair fails an integrity gate), so the controls run on an ideal successor: the v96 rows and model with only the declared reason sentences replaced. The classifier admits it, then rejects each mutation.",
  "controls": {
    "value": {
      "rejected": true,
      "gate": "publication value or symbol"
    },
    "page_value": {
      "rejected": true,
      "gate": "page value/disposition/code/reason/question"
    },
    "boolean_value": {
      "rejected": true,
      "gate": "page value/disposition/code/reason/question"
    },
    "disposition": {
      "rejected": true,
      "gate": "disposition/code/missing/guard"
    },
    "code": {
      "rejected": true,
      "gate": "disposition/code/missing/guard"
    },
    "missing_name": {
      "rejected": true,
      "gate": "disposition/code/missing/guard"
    },
    "unplanned_sentence": {
      "rejected": true,
      "gate": "whole model allowlist"
    },
    "question_identity": {
      "rejected": true,
      "gate": "page value/disposition/code/reason/question"
    },
    "added_row": {
      "rejected": true,
      "gate": "added/removed row"
    },
    "removed_row": {
      "rejected": true,
      "gate": "added/removed row"
    },
    "added_field": {
      "rejected": true,
      "gate": "added/removed page field"
    },
    "removed_field": {
      "rejected": true,
      "gate": "added/removed page field"
    },
    "planned_text_wrong_property": {
      "rejected": true,
      "gate": "whole model allowlist"
    },
    "old_reason_kept": {
      "rejected": true,
      "gate": "page value/disposition/code/reason/question"
    },
    "wrong_reason_sentence": {
      "rejected": true,
      "gate": "page value/disposition/code/reason/question"
    }
  }
}
