            "type": "boolean"
          },
          "title": "Taxpayer was totally blind as of December 31, 2025, or has a statement certified by an eye doctor that the taxpayer cannot see better than 20/200 in the better eye with glasses or contact lenses, or that the field of vision is 20 degrees or less.",
          "declared_default": "parameter.default-false v1",
          "default_value": false,
          "default_applies": false,
          "input_questions": [
            {
              "id": "input-question.taxpayer-blind",
              "version": "v1",
              "question": "Were you totally blind on December 31, 2025, or do you have a statement certified by your eye doctor (ophthalmologist or optometrist) that you can't see better than 20/200 in your better eye with glasses or contact lenses, or that your field of vision is 20 degrees or less?"
            }
          ]
        },
        "spouse-over-65": {
          "binding": {
            "symbol": "spouse_over_65",
            "mode": "required",
            "fact_type_version": "v1"
          },
          "declared_in": "core_calculations.vocabulary v3",
