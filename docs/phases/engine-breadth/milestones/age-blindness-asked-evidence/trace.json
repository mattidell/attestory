            "fact_type_version": "v1"
          },
          "declared_in": "core_calculations.vocabulary v3",
          "fact_type_version": "v1",
          "value_schema": {
            "type": "boolean"
          },
          "title": "Taxpayer was born before January 2, 1961. A person reaches age 65 on the day before the 65th birthday. A taxpayer who was born before January 2, 1961 but died in 2025 before reaching age 65 is not included.",
          "declared_default": "parameter.default-false v1",
          "default_value": false,
          "default_applies": false,
          "input_questions": [
            {
              "id": "input-question.taxpayer-over-65",
              "version": "v1",
              "question": "Were you born before January 2, 1961? A person reaches age 65 on the day before their 65th birthday, so a birthday of January 1, 1961 counts and January 2, 1961 does not. If this return is for someone who died in 2025 before reaching age 65, answer no."
            }
          ]
        },
        "taxpayer-blind": {
          "binding": {
            "symbol": "taxpayer_blind",
            "mode": "required",
            "fact_type_version": "v1"
