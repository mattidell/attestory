{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finances-app.local/schemas/run-manifest.schema.json",
  "title": "Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "workspace_id",
    "tax_year",
    "jurisdiction",
    "engine_version",
    "created_at",
    "inputs",
    "outputs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "tax_year": {
      "type": "integer",
      "minimum": 2000
    },
    "jurisdiction": {
      "type": "string",
      "const": "federal"
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/runArtifactRef"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/runArtifactRef"
      }
    }
  },
  "$defs": {
    "runArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "path", "media_type"],
      "properties": {
        "artifact_type": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
