{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finances-app.local/schemas/source-document.schema.json",
  "title": "Source Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_document_id",
    "source_revision_id",
    "document_type",
    "tax_year",
    "entered_at",
    "label",
    "fields"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "source_document_id": {
      "type": "string",
      "minLength": 1
    },
    "source_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "document_type": {
      "type": "string",
      "enum": ["w2", "1099-int"]
    },
    "tax_year": {
      "type": "integer",
      "minimum": 2000
    },
    "entered_at": {
      "type": "string",
      "format": "date-time"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceField"
      }
    }
  },
  "$defs": {
    "sourceField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_field_id",
        "field_number",
        "label",
        "required",
        "value"
      ],
      "properties": {
        "source_field_id": {
          "type": "string",
          "minLength": 1
        },
        "field_number": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "value": {
          "oneOf": [
            { "$ref": "#/$defs/moneyValue" },
            { "type": "string" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        }
      }
    },
    "moneyValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency", "scale"],
      "properties": {
        "amount": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "const": "USD"
        },
        "scale": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
