{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finances-app.local/schemas/product-run-detail.schema.json",
  "title": "Product Run Detail",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_summary",
    "run_payload",
    "artifact_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "run_summary": {
      "type": "object"
    },
    "run_payload": {
      "type": "object"
    },
    "artifact_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifactReference"
      }
    }
  },
  "$defs": {
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "media_type", "uri"],
      "properties": {
        "artifact_type": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^/"
          }
        }
      }
    }
  }
}
