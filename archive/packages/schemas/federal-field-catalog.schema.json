{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finances-app.local/schemas/federal-field-catalog.schema.json",
  "title": "Federal Field Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tax_year",
    "jurisdiction",
    "fields"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "tax_year": {
      "type": "integer",
      "minimum": 2000
    },
    "jurisdiction": {
      "type": "string",
      "const": "federal"
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "form_id",
        "label",
        "required",
        "population_mode"
      ],
      "properties": {
        "field_id": {
          "type": "string",
          "minLength": 1
        },
        "form_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "population_mode": {
          "type": "string",
          "enum": ["direct", "computed", "optional"]
        }
      }
    }
  }
}
