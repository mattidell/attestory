{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finances-app.local/schemas/product-run-payload.schema.json",
  "title": "Product Run Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "owner_id",
    "workspace_id",
    "tax_year",
    "jurisdictions",
    "data_classification",
    "source_draft_snapshots"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "tax_year": {
      "type": "integer",
      "minimum": 2000
    },
    "jurisdictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["federal"]
      }
    },
    "data_classification": {
      "type": "string",
      "enum": ["synthetic_demo"]
    },
    "source_draft_snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceDraftSnapshot"
      }
    }
  },
  "$defs": {
    "sourceDraftSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draft_id",
        "document_type",
        "revision_id",
        "payload"
      ],
      "properties": {
        "draft_id": {
          "type": "string",
          "minLength": 1
        },
        "document_type": {
          "type": "string",
          "enum": ["w2", "1099-int"]
        },
        "revision_id": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object"
        }
      }
    }
  }
}
