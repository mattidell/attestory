{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finances-app.local/schemas/source-document-draft.schema.json",
  "title": "Source Document Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_document_id",
    "source_revision_id",
    "document_type",
    "tax_year",
    "entered_at",
    "label",
    "field_values"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "source_document_id": {
      "type": "string",
      "minLength": 1
    },
    "source_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "document_type": {
      "type": "string",
      "enum": ["w2", "1099-int"]
    },
    "tax_year": {
      "type": "integer",
      "minimum": 2000
    },
    "entered_at": {
      "type": "string",
      "format": "date-time"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "field_values": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/draftFieldValue"
      }
    }
  },
  "$defs": {
    "draftFieldValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_field_id", "value"],
      "properties": {
        "source_field_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["amount", "currency", "scale"],
              "properties": {
                "amount": { "type": "integer" },
                "currency": { "type": "string", "const": "USD" },
                "scale": { "type": "integer", "minimum": 0 }
              }
            },
            { "type": "string" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
