{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finances-app.local/schemas/local-source-draft-latest.schema.json",
  "title": "Local Source Draft Latest Pointer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "draft_id",
    "document_type",
    "revision_id",
    "uri"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "draft_id": {
      "type": "string",
      "minLength": 1
    },
    "document_type": {
      "type": "string",
      "enum": ["w2", "1099-int"]
    },
    "revision_id": {
      "type": "string",
      "minLength": 1
    },
    "uri": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "^/"
      }
    }
  }
}
